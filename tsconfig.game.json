{
  // Chứng minh logic game không phụ thuộc DOM hay Node, để server dùng lại được.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    // Không kế thừa JSX của web: preact/jsx-runtime kéo lib.dom vào chương trình.
    "jsx": null,
    "jsxImportSource": null
  },
  // Bộ soạn nhạc cũng phải thuần (không Web Audio, không DOM).
  "include": ["src/game", "src/audio/music/composer.ts", "src/audio/music/themes.ts"]
}
