{
  "name": "skyline-garden",
  "private": true,
  "version": "0.1.0",
  "description": "Game nông trại trên mây, 3D low-poly, chạy trên trình duyệt bằng three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.game.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@preact/signals-core": "^1.14.4",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
